<Project>

  <PropertyGroup>
    <!-- Keep the app, Core and tests on one supported LTS runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols travel inside the assembly instead of as sidecar .pdb files. Keeps a single-file
         publish actually single, and means stack traces in bug reports keep their line numbers. -->
    <DebugType>embedded</DebugType>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>1.2.0</Version>
    <Authors>Gentian Shkembi</Authors>
    <Product>PgpUtility</Product>
  </PropertyGroup>

</Project>
