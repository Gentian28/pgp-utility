<Project>

  <PropertyGroup>
    <!-- One target framework for every project that can have one. The App project overrides this
         while it is still WPF; everything below it stays on plain net8.0 so the tests run on
         Linux and macOS unchanged after the Avalonia port. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols travel inside the assembly instead of as sidecar .pdb files. Keeps a single-file
         publish actually single, and means stack traces in bug reports keep their line numbers. -->
    <DebugType>embedded</DebugType>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>1.0.0</Version>
    <Authors>Gentian Shkembi</Authors>
    <Product>PgpUtility</Product>
  </PropertyGroup>

</Project>
