<UserControl x:Class="PgpUtility.Views.KeyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PgpUtility.ViewModels"
             xmlns:converters="clr-namespace:PgpUtility.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:KeyManagementViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource StandardTextBox}"
                 Margin="0,0,0,8" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Import Key" Command="{Binding ImportKeyCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Export Key" Command="{Binding ExportKeyCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Delete Key" Command="{Binding DeleteKeyCommand}"
                    Style="{StaticResource DangerButton}" Margin="0,0,8,0" />
            <Button Content="Copy Public Key" Command="{Binding CopyPublicKeyCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <!-- Master-Detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Key List -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{StaticResource SurfaceBrush}">
                <ListBox ItemsSource="{Binding FilteredKeys}"
                         SelectedItem="{Binding SelectedKey}"
                         BorderThickness="0" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding UserId}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KeyId}" Foreground="{StaticResource GrayBrush}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Key Details -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{StaticResource SurfaceBrush}" Padding="12">
                <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Key Details" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Key ID" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.KeyId}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8" />

                    <TextBlock Text="User ID" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.UserId}" FontSize="12" Margin="0,0,0,8" />

                    <TextBlock Text="Fingerprint" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.Fingerprint}" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Text="Algorithm" Style="{StaticResource FieldLabel}" />
                    <TextBlock FontSize="12" Margin="0,0,0,8">
                        <Run Text="{Binding SelectedKey.Algorithm}" />
                        <Run Text=" (" /><Run Text="{Binding SelectedKey.KeySize}" /><Run Text=" bit)" />
                    </TextBlock>

                    <TextBlock Text="Created" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.CreationDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                               FontSize="12" Margin="0,0,0,8" />

                    <TextBlock Text="Has Public Key" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.HasPublicKey}" FontSize="12" Margin="0,0,0,8" />

                    <TextBlock Text="Has Private Key" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedKey.HasPrivateKey}" FontSize="12" Margin="0,0,0,8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
    </Grid>
</UserControl>
