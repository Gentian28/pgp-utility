<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PgpUtility.App.ViewModels"
             xmlns:models="using:PgpUtility.Models"
             mc:Ignorable="d"
             x:Class="PgpUtility.App.Views.TextView"
             x:DataType="vm:TextViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto,*" Margin="16" >

    <!-- Action -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
      <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" MinWidth="130" />
      <ComboBox ItemsSource="{Binding AvailableKeys}"
                SelectedValue="{Binding SelectedKeyId}"
                SelectedValueBinding="{Binding KeyId, x:DataType=models:PgpKeyInfo}"
                MinWidth="300">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:PgpKeyInfo">
            <TextBlock>
              <Run Text="{Binding UserId}" />
              <Run Text="{Binding KeyId, StringFormat=' ({0})'}"
                   Foreground="{DynamicResource MutedTextBrush}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox x:Name="PassphraseBox" PasswordChar="●" Width="220"
               Watermark="Passphrase" IsVisible="{Binding NeedsPassphrase}" />
    </StackPanel>

    <!-- Input header -->
    <DockPanel Grid.Row="1" Margin="0,0,0,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Paste" Command="{Binding PasteCommand}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
      </StackPanel>
      <TextBlock Text="Input" Classes="sectionHeader" VerticalAlignment="Center" />
    </DockPanel>

    <!-- Stretch explicitly: the theme centres a TextBox by default, so in a star-sized row it
         collapses to a single-line strip floating in the middle instead of filling the space. -->
    <TextBox Grid.Row="2" Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
             FontFamily="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace" FontSize="12"
             Watermark="Type or paste here. Paste detects an encrypted or signed block and picks the action for you." />

    <!-- Output header -->
    <DockPanel Grid.Row="3" Margin="0,12,0,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Copy" Command="{Binding CopyOutputCommand}" />
        <Button Classes="Primary" Content="{Binding ActionLabel}"
                Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
      <TextBlock Text="Output" Classes="sectionHeader" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="4" RowDefinitions="*,Auto">
      <TextBox Grid.Row="0" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap"
               VerticalAlignment="Stretch" VerticalContentAlignment="Top"
               FontFamily="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace" FontSize="12" />

      <!-- Verification verdict, for the Verify action -->
      <Border Grid.Row="1" Classes="panel" Padding="10" Margin="0,8,0,0"
              IsVisible="{Binding HasResult}">
        <StackPanel Spacing="4" DataContext="{Binding Result}" x:DataType="models:SignatureVerification">
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding IsValid, Converter={x:Static vm:Converters.SignatureHeadline}}"
                     Foreground="{Binding IsValid, Converter={x:Static vm:Converters.SignatureBrush}}" />
          <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Classes="warning" Text="{Binding Caveat}"
                     IsVisible="{Binding Caveat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
