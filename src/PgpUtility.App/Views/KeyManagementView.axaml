<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PgpUtility.App.ViewModels"
             xmlns:models="using:PgpUtility.Models"
             mc:Ignorable="d"
             x:Class="PgpUtility.App.Views.KeyManagementView"
             x:DataType="vm:KeyManagementViewModel">

  <Grid ColumnDefinitions="*,Auto,320" Margin="16">

    <!-- Key list -->
    <DockPanel Grid.Column="0">
      <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" Margin="0,0,0,8"
               Watermark="Search by name, key id or fingerprint" />

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Import file..." Command="{Binding ImportKeyCommand}" />
        <Button Content="Import from clipboard" Command="{Binding ImportFromClipboardCommand}" />
      </StackPanel>

      <Border Classes="panel">
        <ListBox ItemsSource="{Binding FilteredKeys}" SelectedItem="{Binding SelectedKey}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:PgpKeyInfo">
              <StackPanel Spacing="2" Margin="0,4">
                <TextBlock Text="{Binding UserId}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding KeyId}" Classes="hint"
                             FontFamily="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace" />
                  <TextBlock Text="{Binding Algorithm}" Classes="hint" />
                  <TextBlock Text="secret key" Classes="hint"
                             IsVisible="{Binding HasPrivateKey}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <Border Grid.Column="1" Width="16" />

    <!-- Detail. IsVisible sits on the outer panel on purpose: a DataContext set on an element
         also applies to that element's own bindings, so putting both on one panel would look up
         HasSelection on PgpKeyInfo. -->
    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="10" DataContext="{Binding SelectedKey}"
                  x:DataType="models:PgpKeyInfo">

        <TextBlock Text="{Binding UserId}" Classes="sectionHeader" TextWrapping="Wrap" />

        <StackPanel Spacing="2">
          <TextBlock Text="Fingerprint" Classes="fieldLabel" />
          <SelectableTextBlock
              Text="{Binding Fingerprint, Converter={x:Static vm:Converters.SpacedFingerprint}}"
              FontFamily="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace"
              FontSize="11" TextWrapping="Wrap" />
          <TextBlock Classes="hint"
                     Text="Compare this with the owner over a channel you already trust. It is the only thing that proves the key is theirs." />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="Key id" Classes="fieldLabel" />
          <SelectableTextBlock Text="{Binding KeyId}" FontSize="12"
                               FontFamily="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="Algorithm" Classes="fieldLabel" />
          <TextBlock FontSize="12">
            <Run Text="{Binding Algorithm}" />
            <Run Text="{Binding KeySize, StringFormat=' ({0} bits)'}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="Created" Classes="fieldLabel" />
          <TextBlock FontSize="12"
                     Text="{Binding CreationDate, Converter={x:Static vm:Converters.ShortDate}}" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="Expiry" Classes="fieldLabel" />
          <TextBlock FontSize="12"
                     Text="{Binding ExpirationDate, Converter={x:Static vm:Converters.ExpiryText}}" />
          <TextBlock Classes="warning"
                     Text="This key has expired. Others will refuse to encrypt to it."
                     IsVisible="{Binding ExpirationDate, Converter={x:Static vm:Converters.HasExpired}}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Actions pinned under the detail pane -->
    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="8"
                IsVisible="{Binding HasSelection}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Copy public key" Command="{Binding CopyPublicKeyCommand}" />
        <Button Content="Copy fingerprint" Command="{Binding CopyFingerprintCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Export public..." Command="{Binding ExportPublicKeyCommand}" />
        <Button Content="Export private..." Command="{Binding ExportPrivateKeyCommand}"
                IsVisible="{Binding SelectedHasPrivateKey}" />
      </StackPanel>
      <Button Content="Delete key" Classes="Danger" Command="{Binding DeleteKeyCommand}"
              HorizontalAlignment="Stretch" />
    </StackPanel>

  </Grid>
</UserControl>
