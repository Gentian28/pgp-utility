<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PgpUtility.App.ViewModels"
             xmlns:models="using:PgpUtility.Models"
             mc:Ignorable="d"
             x:Class="PgpUtility.App.Views.EncryptDecryptView"
             x:DataType="vm:EncryptDecryptViewModel">

  <ScrollViewer Padding="16">
    <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">

      <!-- Mode -->
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton Content="Encrypt" GroupName="Mode" IsChecked="{Binding IsEncryptMode}" />
        <RadioButton Content="Decrypt" GroupName="Mode" IsChecked="{Binding !IsEncryptMode}" />
      </StackPanel>

      <!-- Files -->
      <StackPanel Spacing="6">
        <TextBlock Text="Files" Classes="sectionHeader" />
        <!-- A ListBox rather than a DataGrid: the grid needs its own package and theme, and a
             template gives each row a remove button, which the column layout never had. -->
        <Border Classes="panel" MinHeight="150" x:Name="DropTarget">
          <Panel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Files}" Margin="4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BatchFileItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,4">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ErrorMessage}" Classes="hint" FontSize="11"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="hint"
                                 VerticalAlignment="Center" Margin="8,0" />
                      <Button Grid.Column="2" Content="✕" FontSize="11" Padding="6,2"
                              Command="{Binding $parent[ItemsControl].((vm:EncryptDecryptViewModel)DataContext).RemoveFileCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Drop files here, or use Add files"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                       IsVisible="{Binding !Files.Count}" />
          </Panel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Add files" Command="{Binding AddFilesCommand}" />
          <Button Content="Clear" Command="{Binding ClearFilesCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Key -->
      <StackPanel Spacing="6">
        <TextBlock Text="Key" Classes="sectionHeader" />
        <RadioButton Content="Use a key from the store" GroupName="KeySource"
                     IsChecked="{Binding UseKeyFromStore}" />
        <ComboBox ItemsSource="{Binding AvailableKeys}"
                  SelectedValue="{Binding SelectedKeyId}"
                  SelectedValueBinding="{Binding KeyId, x:DataType=models:PgpKeyInfo}"
                  IsEnabled="{Binding UseKeyFromStore}"
                  HorizontalAlignment="Stretch"
                  Margin="24,0,0,0">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:PgpKeyInfo">
              <TextBlock>
                <Run Text="{Binding UserId}" />
                <Run Text="{Binding KeyId, StringFormat=' ({0})'}"
                     Foreground="{DynamicResource MutedTextBrush}" />
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <RadioButton Content="Use a key file" GroupName="KeySource"
                     IsChecked="{Binding !UseKeyFromStore}" />
        <DockPanel Margin="24,0,0,0">
          <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                  Command="{Binding BrowseKeyCommand}"
                  IsEnabled="{Binding !UseKeyFromStore}" />
          <TextBox Text="{Binding KeyFilePath}" IsEnabled="{Binding !UseKeyFromStore}"
                   Watermark="Path to a key file" />
        </DockPanel>
      </StackPanel>

      <!-- Passphrase, decrypt only -->
      <StackPanel Spacing="4" IsVisible="{Binding !IsEncryptMode}">
        <TextBlock Text="Passphrase" Classes="fieldLabel" />
        <TextBox x:Name="PassphraseBox" PasswordChar="●" Width="420"
                 HorizontalAlignment="Left" Watermark="Passphrase for the private key" />
        <TextBlock Classes="hint"
                   Text="Cleared once the batch finishes, so you will be asked again next time." />
      </StackPanel>

      <!-- Output -->
      <StackPanel Spacing="4">
        <TextBlock Text="Output folder" Classes="fieldLabel" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                  Command="{Binding BrowseOutputDirectoryCommand}" />
          <TextBox Text="{Binding OutputDirectory}" Watermark="Where the results are written" />
        </DockPanel>
      </StackPanel>

      <!-- Options. The integrity check used to be a checkbox. It is not a choice any more:
           turning it off produced malleable ciphertext and bought nothing. -->
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Content="ASCII armor" IsChecked="{Binding AsciiArmor}"
                  IsVisible="{Binding IsEncryptMode}" />
        <TextBlock Text="AES-256, integrity protected" Classes="hint"
                   VerticalAlignment="Center" IsVisible="{Binding IsEncryptMode}" />
      </StackPanel>

      <!-- Progress -->
      <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" />
        <TextBlock Text="{Binding CurrentFileStatus}" Classes="hint" />
      </StackPanel>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding IsEncryptMode, Converter={x:Static vm:Converters.EncryptOrDecrypt}}"
                Classes="Primary"
                Command="{Binding ProcessCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Cancel" Classes="Danger"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsBusy}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
