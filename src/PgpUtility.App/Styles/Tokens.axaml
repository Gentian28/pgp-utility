<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sits on top of SemiTheme rather than replacing it: only the handful of things this app
       repeats often enough to be worth naming. Everything else is Semi's. -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5C6470" />
          <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FA" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#E3E6EB" />
          <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
          <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3B0" />
          <SolidColorBrush x:Key="PanelBrush" Color="#1B1D21" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#33373D" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.keyBlock">
    <Setter Property="FontFamily" Value="Cascadia Code,Menlo,DejaVu Sans Mono,Consolas,monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="MaxHeight" Value="180" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

</Styles>
